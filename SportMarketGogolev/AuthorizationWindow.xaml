<Window x:Class="SportMarketGogolev.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportMarketGogolev"
        mc:Ignorable="d"
        Title="AuthorizationWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Почта" Grid.Row="0"/>
        <TextBox x:Name="EmalTB" Grid.Row="0" Grid.Column="2"/>

        <TextBlock Text="Пароль" Grid.Row="2"/>
        <PasswordBox x:Name="PassPB" Grid.Row="2" Grid.Column="2"/>

        <Button x:Name="EnterBtn" Click="EnterBtn_Click" Content="Войти" Grid.Row="4" Grid.ColumnSpan="3" Width="250" Height="50"/>
        <Button x:Name="RegBtn" Click="RegBtn_Click" Content="Зарегистрироваться" Grid.Row="6" Grid.ColumnSpan="3" Width="250" Height="50"/>
    </Grid>
</Window>
