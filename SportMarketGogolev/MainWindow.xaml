<Window x:Class="SportMarketGogolev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportMarketGogolev"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
            </Grid.ColumnDefinitions>
            <TextBox TextChanged="SearchTB_TextChanged" Height="30" x:Name="SearchTB"/>
            <Button x:Name="AddBtn" Click="AddBtn_Click" Grid.Column="2" Content="Добавить продукт" Width="auto" Height="30" HorizontalAlignment="Left"/>
            <Button x:Name="Remove" Click="Remove_Click" Grid.Column="4" Content="Удалить продукт" Width="auto" Height="30" HorizontalAlignment="Left"/>
            <ComboBox Grid.Column="6" Width="200" Height="30" Name="SwithCmb" SelectionChanged="SwithCmb_SelectionChanged"/>
        </Grid>
        
        <ListView x:Name="InfoLV" Grid.Row="2" Grid.ColumnSpan="6">
            <ListView.View>
                <GridView>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
